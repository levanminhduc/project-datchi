# ============================================
# Đất Chỉ - Docker Environment Variables
# Copy file này thành .env.docker rồi điền giá trị
# ============================================

# ── Ports ──────────────────────────────────
FRONTEND_PORT=8080
BACKEND_PORT=3010

# ── Image version (mặc định: latest) ──────
# IMAGE_TAG=latest
# IMAGE_TAG=v1.0.0

# ── Frontend URL (để backend CORS cho phép) ─
FRONTEND_URL=http://localhost:8080

# ── PostgreSQL connection ──────────────────
# Backend dùng kết nối pg trực tiếp (thay PostgREST của Supabase).
# Trỏ tới Postgres thật; quản trị DB qua pgAdmin4 trên DATABASE_URL này
# (PostgreSQL thuần — không còn Supabase Studio). Backend fail fast nếu thiếu.
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/datchi

# ── Storage (W4: ảnh hướng dẫn lưu trên filesystem) ──
# STORAGE_DIR: đường dẫn trong container. Backend fail fast nếu thư mục không ghi được.
# STORAGE_HOST_DIR: thư mục thật trên máy host được mount vào STORAGE_DIR.
# Chuyển máy / backup: copy nguyên thư mục STORAGE_HOST_DIR + backup DB là đủ, ảnh giữ nguyên.
STORAGE_DIR=/data/storage
STORAGE_HOST_DIR=./storage

# ── W2 Auth: JWT signing secret (HS256) ────
# Chuỗi ngẫu nhiên dài (>= 32 bytes). Backend ký & verify access token bằng key
# này; token ký bởi issuer khác bị từ chối. ĐẶT secret mạnh trước khi chạy thật.
JWT_SIGNING_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes

# ── Telegram Bot (tùy chọn) ───────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret
TELEGRAM_WEBHOOK_URL=https://your-domain.example/api/telegram/webhook

# ── Chatbot service (tùy chọn) ────────────
# Nếu chạy datchi-chatbot-service ngoài compose, dùng host.docker.internal.
# CHATBOT_SERVICE_URL=http://host.docker.internal:8010
# CHATBOT_INTERNAL_TOKEN=change-me
CHATBOT_REQUEST_TIMEOUT_MS=15000
