# Server Configuration
PORT=3000
FRONTEND_URL=http://localhost:5173

# Frontend API Configuration
VITE_API_URL=http://localhost:3000

# Supabase Configuration (VITE_ prefix required for frontend access)
VITE_SUPABASE_URL=http://127.0.0.1:55421
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend also uses these (keep NEXT_PUBLIC for backward compatibility)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Telegram Bot (optional - for external notifications)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret
TELEGRAM_WEBHOOK_URL=https://your-domain.example/api/telegram/webhook

# Chatbot service (optional)
# Enable these when datchi-chatbot-service is running.
# CHATBOT_SERVICE_URL=http://127.0.0.1:8010
# CHATBOT_INTERNAL_TOKEN=change-me
CHATBOT_REQUEST_TIMEOUT_MS=15000

# Gemini chatbot provider (optional, server-side only)
# Default model in code is gemini-2.5-flash-lite to save free-tier quota.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_REQUEST_TIMEOUT_MS=20000
GEMINI_MAX_OUTPUT_TOKENS=2048
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# OpenAI-compatible chatbot provider (optional, server-side only)
# Uses Clawd proxy by default. Takes priority over Gemini.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.4-mini
OPENAI_API_BASE_URL=https://agent-shop.clawd.io.vn/v1
OPENAI_REQUEST_TIMEOUT_MS=30000
OPENAI_MAX_OUTPUT_TOKENS=2048
