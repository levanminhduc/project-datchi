# Server Configuration
PORT=3000
FRONTEND_URL=http://localhost:5173

# PostgreSQL connection (W1: direct pg data-access, replaces Supabase PostgREST)
# The backend fails fast on startup if this is unset.
# DB administration is done via pgAdmin4 connected to this DATABASE_URL
# (plain PostgreSQL — there is no Supabase Studio anymore).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/datchi
# Optional pool tuning
# DATABASE_POOL_MAX=10
# DATABASE_POOL_IDLE_TIMEOUT_MS=30000
# DATABASE_POOL_CONNECTION_TIMEOUT_MS=10000

# W4 Storage: local filesystem directory for guide images (replaces Supabase Storage).
# The backend fails fast on first use if this is unset or not writable.
# Files are served at /api/guides/images/<path> and the preserved public path
# /storage/v1/object/public/guide-images/<path>.
STORAGE_DIR=./storage

# Frontend API Configuration
VITE_API_URL=http://localhost:3000

# W2 Auth: self-hosted JWT signing secret (HS256). Replaces Supabase GoTrue.
# Use a long random string (>= 32 bytes). The backend signs and verifies access
# tokens with this key; tokens signed by any other issuer are rejected.
JWT_SIGNING_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
# Optional token lifetimes (defaults: access 1h, refresh 7d)
# JWT_ACCESS_TTL_SECONDS=3600
# JWT_REFRESH_TTL_SECONDS=604800

# Telegram Bot (optional - for external notifications)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret
TELEGRAM_WEBHOOK_URL=https://your-domain.example/api/telegram/webhook

# Chatbot service (optional)
# Enable these when datchi-chatbot-service is running.
# CHATBOT_SERVICE_URL=http://127.0.0.1:8010
# CHATBOT_INTERNAL_TOKEN=change-me
CHATBOT_REQUEST_TIMEOUT_MS=15000

# Gemini chatbot provider (optional, server-side only)
# Default model in code is gemini-2.5-flash-lite to save free-tier quota.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_REQUEST_TIMEOUT_MS=20000
GEMINI_MAX_OUTPUT_TOKENS=2048
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# OpenAI-compatible chatbot provider (optional, server-side only)
# Uses Clawd proxy by default. Takes priority over Gemini.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.4-mini
OPENAI_API_BASE_URL=https://agent-shop.clawd.io.vn/v1
OPENAI_REQUEST_TIMEOUT_MS=30000
OPENAI_MAX_OUTPUT_TOKENS=2048
